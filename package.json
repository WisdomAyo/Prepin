{
  "name": "interview-copilot",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/ui",
    "packages/frontend",
    "packages/desktop"
  ],
  "scripts": {
    "dev:web": "npm run dev -w packages/frontend",
    "dev:desktop": "npm run dev -w packages/desktop",
    "build:web": "npm run build -w packages/frontend",
    "build:desktop": "npm run build -w packages/desktop",
    "lint": "npm run lint -w packages/frontend -w packages/desktop -w packages/shared -w packages/ui",
    "typecheck": "npm run typecheck -w packages/frontend -w packages/desktop -w packages/shared -w packages/ui"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron-vite": "^5.0.0"
  }
}
