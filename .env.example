# ── Provider Profile ──────────────────────────────────────────
# Switch the ENTIRE stack between local and cloud with one variable.
# "local" = Ollama + faster-whisper + local embeddings, $0 API spend.
# "cloud" = Claude Sonnet + Deepgram/AssemblyAI + cloud embeddings.
PROVIDER_PROFILE=local

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev
POSTGRES_DB=copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev@localhost:5432/copilot

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Local AI (used when PROVIDER_PROFILE=local) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── Cloud AI (used when PROVIDER_PROFILE=cloud) ───────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6-20250514
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ── Observability (optional) ──────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
